# 复制为 .env 并填写真实值（.env 已被 gitignore）
# Docker 部署时，DB_HOST/REDIS_HOST 在 docker-compose.yml 中已配置为服务名，无需在此修改

# 数据库 / Redis（本地开发用，Docker 部署以 docker-compose.yml 为准）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ielts_courses
DB_USER=root
DB_PASSWORD=Jackson@mysql
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT 密钥（生产必须改，至少 32 字符随机串）
JWT_SECRET=change-me-please-use-a-long-random-secret-32bytes

# 腾讯云点播 VOD（视频播放必需，留空则视频功能不可用）
VOD_APP_ID=
VOD_SUB_APP_ID=0
VOD_SECRET_ID=
VOD_SECRET_KEY=
VOD_PLAY_KEY=
# 腾讯云 COS（封面图 / 课件上传，配置后可在后台直接上传文件）
# 存储桶名称，形如 courses-1250000000（在 COS 控制台创建后复制，含 APPID 后缀）
COS_BUCKET=
# 存储桶地域，如 ap-guangzhou / ap-shanghai / ap-beijing
COS_REGION=ap-guangzhou
# 访问域名前缀（可选）。若用 CDN 加速域名或自定义域名填这里；留空则用 COS 默认域名
# 注意：封面/课件需可被浏览器读取，存储桶请设为公有读或绑定公有访问域名
COS_PREVIEW_URL=
# COS 密钥（可选）：不单独配置时默认复用上面的 VOD_SECRET_ID / VOD_SECRET_KEY（同一腾讯云账号即可）
COS_SECRET_ID=
COS_SECRET_KEY=

# 微信相关（当前用手机号登录，暂不需要；接入支付时再填）
WX_OPEN_APP_ID=
WX_OPEN_APP_SECRET=
WX_MP_APP_ID=
WX_MP_APP_SECRET=
WX_MCH_ID=
WX_API_V3_KEY=
WX_PAY_NOTIFY_URL=
